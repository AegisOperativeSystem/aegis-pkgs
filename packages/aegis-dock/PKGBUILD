pkgname=aegis-dock
pkgver=1.0.6
pkgrel=1
pkgdesc='Aegis desktop dock'
arch=(x86_64)
url='https://github.com/AegisOperativeSystem/aegis-os'
license=(GPL-3.0-only)
depends=(gtk4 gtk4-layer-shell adwaita-icon-theme)
makedepends=(rust cargo pkgconf)
options=('!debug')

_tree() {
  if [[ -n "${AEGIS_OS_PATH:-}" ]]; then
    printf '%s\n' "${AEGIS_OS_PATH}"
  else
    printf '%s\n' "${srcdir}/aegis-os"
  fi
}

prepare() {
  if [[ -n "${AEGIS_OS_PATH:-}" ]]; then
    return
  fi
  rm -rf aegis-os
  git clone --depth 1 --branch main https://github.com/AegisOperativeSystem/aegis-os.git aegis-os
}

build() {
  cd "$(_tree)"
  cargo build --locked --release -p aegis-dock
}

package() {
  cd "$(_tree)"
  install -Dm755 target/release/aegis-dock "${pkgdir}/usr/bin/aegis-dock"
  install -Dm644 components/aegis-dock/assets/style.css "${pkgdir}/usr/share/aegis/dock/style.css"
}
