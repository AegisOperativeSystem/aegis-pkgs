pkgname=aegis-session
pkgver=1.0.8
pkgrel=1
pkgdesc='Aegis Wayland session'
arch=(x86_64)
url='https://github.com/AegisOperativeSystem/aegis-os'
license=(GPL-3.0-only)
depends=(aegis-shell aegis-dock aegis-tour labwc swaybg foot polkit-gnome pipewire wireplumber)
makedepends=(git)

_tree() {
  if [[ -n "${AEGIS_OS_PATH:-}" ]]; then
    printf '%s\n' "${AEGIS_OS_PATH}"
  else
    printf '%s\n' "${srcdir}/aegis-os"
  fi
}

prepare() {
  if [[ -n "${AEGIS_OS_PATH:-}" ]]; then
    return
  fi
  rm -rf aegis-os
  git clone --depth 1 --branch main https://github.com/AegisOperativeSystem/aegis-os.git aegis-os
}

package() {
  local tree
  tree="$(_tree)"
  install -Dm755 "${tree}/session/bin/aegis-session" "${pkgdir}/usr/bin/aegis-session"
  install -Dm755 "${tree}/session/xdg/labwc/autostart" "${pkgdir}/etc/xdg/labwc/autostart"
  install -Dm644 "${tree}/session/xdg/labwc/rc.xml" "${pkgdir}/etc/xdg/labwc/rc.xml"
  install -Dm644 "${tree}/session/xdg/labwc/environment" "${pkgdir}/etc/xdg/labwc/environment"
  install -Dm644 "${tree}/session/themes/aegis/openbox-3/themerc" \
    "${pkgdir}/usr/share/themes/aegis/openbox-3/themerc"
  install -Dm644 "${tree}/session/foot/foot.ini" "${pkgdir}/usr/share/aegis/foot.ini"
  install -Dm644 "${tree}/session/background.png" "${pkgdir}/usr/share/aegis/background.png"
  install -Dm644 "${tree}/session/wayland-sessions/aegis.desktop" \
    "${pkgdir}/usr/share/wayland-sessions/aegis.desktop"
  install -Dm644 "${startdir}/os-release" "${pkgdir}/usr/lib/aegis/os-release"
  install -Dm755 "${startdir}/write-os-release" "${pkgdir}/usr/share/aegis/write-os-release"
  install -Dm644 "${startdir}/os-release.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/aegis-os-release.hook"
}
