pkgname=aegis-tour
pkgver=1.0.0
pkgrel=1
pkgdesc='Aegis first-run tour'
arch=(x86_64)
url='https://github.com/AegisOperativeSystem/aegis-os'
license=(GPL-3.0-only)
depends=(gtk4)
makedepends=(rust cargo pkgconf)
options=('!debug')

prepare() {
  rm -rf aegis-os
  if [[ -n "${AEGIS_OS_PATH:-}" ]]; then
    mkdir aegis-os
    cp -a "${AEGIS_OS_PATH}/." aegis-os/
    rm -rf aegis-os/target
  else
    git clone --depth 1 --branch main https://github.com/AegisOperativeSystem/aegis-os.git aegis-os
  fi
}

build() {
  cd aegis-os
  cargo build --locked --release -p aegis-tour
}

package() {
  cd aegis-os
  install -Dm755 target/release/aegis-tour "${pkgdir}/usr/bin/aegis-tour"
  install -Dm644 components/aegis-tour/assets/style.css "${pkgdir}/usr/share/aegis/tour/style.css"
  install -Dm644 session/applications/aegis-tour.desktop \
    "${pkgdir}/usr/share/applications/aegis-tour.desktop"
}
